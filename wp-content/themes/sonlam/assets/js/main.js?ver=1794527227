(function () {
  'use strict';
  var $ = function (s, c) { return (c || document).querySelector(s); };
  var $$ = function (s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); };

  // Header dính: thêm bóng khi cuộn
  var header = $('.sl-header');
  if (header) {
    var onScroll = function () { header.classList.toggle('is-stuck', window.scrollY > 40); };
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }

  // Menu điện thoại
  var nav = $('#sl-nav'), ov = $('.sl-overlay'), tg = $('.sl-menu-tg');
  function setNav(open) {
    if (!nav) return;
    nav.classList.toggle('is-open', open);
    if (ov) ov.hidden = !open;
    if (tg) tg.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.style.overflow = open ? 'hidden' : '';
    document.body.classList.toggle('sl-nav-open', open);
  }
  if (tg) tg.addEventListener('click', function () { setNav(true); });
  if (ov) ov.addEventListener('click', function () { setNav(false); });
  var cl = $('.sl-nav__close'); if (cl) cl.addEventListener('click', function () { setNav(false); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setNav(false); });
  $$('.sl-menu .menu-item-has-children > a').forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (window.innerWidth > 1080) return;
      var li = a.parentElement;
      if (!li.classList.contains('is-open')) { e.preventDefault(); li.classList.add('is-open'); }
    });
  });

  // Nút Chat: mở khung Tawk (launcher mặc định của Tawk đã ẩn)
  var ch = $('.sl-float__btn--chat');
  if (ch) ch.addEventListener('click', function () {
    var T = window.Tawk_API;
    if (T && T.maximize && T.isChatHidden) { try { T.showWidget(); T.maximize(); } catch (e) {} }
    else if (window.slTawkLoad) { window.slTawkOpen = 1; window.slTawkLoad(); }
    else { var z = $('.sl-float__btn--zalo'); if (z) window.open(z.href, '_blank', 'noopener'); }
  });

  // Danh mục sản phẩm: trên điện thoại gập lại, bấm tiêu đề để mở
  document.querySelectorAll('.sl-cat-tg').forEach(function (b) {
    b.addEventListener('click', function () {
      var box = b.closest('.sl-box--cat'); var on = box.classList.toggle('is-open');
      b.setAttribute('aria-expanded', on ? 'true' : 'false');
    });
  });

  // Ô tìm kiếm
  var st = $('.sl-search-tg'), sb = $('#sl-search');
  if (st && sb) st.addEventListener('click', function () {
    sb.hidden = !sb.hidden; st.setAttribute('aria-expanded', sb.hidden ? 'false' : 'true');
    if (!sb.hidden) { var i = $('input[type=search]', sb); if (i) i.focus(); }
  });

  // Banner trượt
  $$('[data-slider]').forEach(function (root) {
    var slides = $$('.sl-hero__slide', root), dots = $$('.sl-hero__dots button', root), i = 0, timer;
    if (slides.length < 2) return;
    function go(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, k) { s.classList.toggle('is-active', k === i); });
      dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
    }
    function auto() { clearInterval(timer); timer = setInterval(function () { go(i + 1); }, 5500); }
    var p = $('.sl-hero__nav--prev', root), n = $('.sl-hero__nav--next', root);
    if (p) p.addEventListener('click', function () { go(i - 1); auto(); });
    if (n) n.addEventListener('click', function () { go(i + 1); auto(); });
    dots.forEach(function (d, k) { d.addEventListener('click', function () { go(k); auto(); }); });
    var x0 = null;
    root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { go(i + (dx < 0 ? 1 : -1)); auto(); } x0 = null;
    });
    auto();
  });

  // Tin tức: nút trượt
  var tr = $('.sl-news__track');
  $$('.sl-news__nav button').forEach(function (b) {
    b.addEventListener('click', function () {
      if (!tr) return; var card = tr.firstElementChild; var w = card ? card.getBoundingClientRect().width + 24 : 300;
      tr.scrollBy({ left: w * parseInt(b.getAttribute('data-dir'), 10), behavior: 'smooth' });
    });
  });

  // Cây danh mục cột bên
  $$('.sl-tree__tg').forEach(function (b) {
    b.addEventListener('click', function () {
      var li = b.parentElement, o = li.classList.toggle('is-open');
      b.setAttribute('aria-expanded', o ? 'true' : 'false');
    });
  });

  // Mô tả danh mục: Xem thêm
  $$('.sl-catdesc').forEach(function (d) {
    var body = $('.sl-catdesc__body', d), btn = $('.sl-catdesc__more', d);
    if (!body || !btn) return;
    if (body.scrollHeight <= 200) { d.removeAttribute('data-collapse'); btn.remove(); return; }
    btn.addEventListener('click', function () { var o = d.classList.toggle('is-open'); btn.textContent = o ? 'Thu gọn' : 'Xem thêm'; });
  });

  // Đếm số khi cuộn tới
  var nums = $$('[data-count]');
  if (nums.length && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return; io.unobserve(e.target);
        var el = e.target, end = parseInt(el.getAttribute('data-count'), 10), txt = el.textContent, t0 = null;
        if (!end || (end >= 1900 && end <= 2100)) return;
        var suf = txt.replace(/[0-9.,\s]/g, '');
        (function step(ts) {
          if (!t0) t0 = ts; var k = Math.min(1, (ts - t0) / 1400);
          el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))).toLocaleString('vi-VN') + suf;
          if (k < 1) requestAnimationFrame(step); else el.textContent = txt;
        })(performance.now());
      });
    }, { threshold: .4 });
    nums.forEach(function (n) { io.observe(n); });
  }
})();
